APP_NAME="EstimaWeb 3.1"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# DOS bases locales:
#   estimaweb31       REFERENCIA. Copia de produccion, se deja intacta para
#                     comparar. No se apunta la aplicacion aqui.
#   estimaweb31_test  DESECHABLE. Es donde trabajan la aplicacion y las
#                     pruebas. Se recrea con: php artisan pruebas:preparar
DB_DATABASE=estimaweb31_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_EXPIRE_ON_CLOSE=true
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Seguridad de la sesion.
# SESSION_SECURE_COOKIE=true en produccion (exige HTTPS). En local se deja
# vacio: con true, el navegador descarta la cookie sobre http y no se puede
# iniciar sesion.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Correo por la API de Microsoft 365.
# En produccion: MAIL_MAILER=graph (arriba). En local se deja en 'log', que
# escribe los correos en storage/logs en vez de enviarlos.
# El remitente debe ser el mismo buzon al que se dio permiso en Azure.
# Comprobar con: php artisan correo:probar
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_GRAPH_SENDER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
