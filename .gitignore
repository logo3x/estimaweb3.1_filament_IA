# Respaldos de produccion importados localmente (datos reales, nunca a git)
/storage/app/respaldos
*.sql

# Datos reales de produccion: nunca al repositorio.
# Los golden masters SI se versionan, pero anonimizados con
# `php artisan golden:anonimizar`. Ver tests/golden/README.md
/storage/app/respaldos
/tests/golden/*.sql
*.sql.zip

# Documentos generados y plantilla local.
# La plantilla real lleva el membrete de la empresa y vive en el servidor.
/storage/app/ofertas
/storage/app/plantillas

# Las librerias mandan sobre los patrones globales de arriba (*.log, *.sql):
# si un paquete trae un archivo asi, debe viajar igual o vendor/ llega roto.
!vendor/**

# Dependencias y assets: SI van al repositorio.
#
# El hosting de destino es cPanel SIN SSH: no hay terminal para correr
# `composer install` ni `npm run build`. Desplegar es un `git pull` desde el
# panel, asi que todo lo que la aplicacion necesita para arrancar tiene que
# estar ya dentro del repositorio.
#
# Por eso NO se ignoran `vendor/`, `public/build/` ni los assets de Filament.
# Se regeneran con `php artisan desplegar:preparar` antes de publicar.
#
# node_modules SI se ignora: solo hace falta para compilar, no para servir.
